    "audit/analyses/brown_adherence/main_linkage_b_amendment/stage2/code/runtime_contract.R"
  ))
  args <- commandArgs(trailingOnly = TRUE)
  stopifnot(length(args) == 1L, args %in% c("ANY", "80"))
  sample <- args[1L]
