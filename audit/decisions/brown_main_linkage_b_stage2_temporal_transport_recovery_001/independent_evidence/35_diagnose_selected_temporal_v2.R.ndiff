  source(file.path(code_root, "31_temporal_reporting_contract.R"))
  source(file.path(code_root, "diagnostic_interface.R"))
  conditional_predictions <- lb_temporal_predictions
  state_label <- c(
    "Wake outside the three hours before sleep" = "Daytime",
    "Pre-sleep" = "Pre-sleep",
    "Sleep environment" = "Sleep"
  )
  seed_registry <- read.csv(file.path(
    stage2_root,
    "preflight/qualified_continuation_001/diagnostic_seed_registry.csv"
