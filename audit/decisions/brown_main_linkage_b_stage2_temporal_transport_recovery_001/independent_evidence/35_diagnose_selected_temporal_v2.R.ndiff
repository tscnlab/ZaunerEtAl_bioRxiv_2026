    seed_row$predictive_seed == 20260814L,
    seed_row$residual_seed == 20260815L
  )
  relative_output <- file.path("diagnostics", paste0("temporal_", sample))
  result <- derive_diagnostics(job$seed_slot, selection$model_path)
  lb_save_rds(result, file.path(relative_output, "raw_diagnostic_checkpoint.rds"))
  rows <- result$row_data
  extra <- summarize_calibration(
    rows,
    c("analysis_state", "day_type"),
    "state_day_type"
  )
  extra[, sample_id := job$seed_slot]
  result$calibration <- data.table::rbindlist(
    list(result$calibration, extra),
    fill = TRUE
  )
  result$participant_influence[, `:=`(
    selected_for_bounded_refit = FALSE,
    deletion_screen_role = "Temporal diagnostic only; no additional deletion slots"
  )]
  expected_rows <- if (sample == "ANY") 2298L else 2069L
  checks <- data.frame(
    check = c(
      "exact_rows_by250_draws",
      "bounded_integer_draws",
      "valid_CDF_bounds",
      "finite_residuals",
      "positive_conditional_variance",
      "nine_state_boundary_rows",
      "five_endpoint_envelopes",
      "six_state_daytype_cells",
      "three_actual_date_series",
      "no_new_deletion_selection",
      "source_model_unchanged",
      "selected_structurally_eligible_route",
      "same_seed_and_draw_slot"
    ),
    pass = c(
      identical(dim(result$simulated_response), c(expected_rows, 250L)),
      all(
        result$simulated_response >= 0 &
          result$simulated_response <= rows$valid_minutes &
          result$simulated_response %% 1 == 0
      ),
      all(
        rows$lower_cdf >= 0 &
          rows$lower_cdf <= rows$upper_cdf &
          rows$upper_cdf <= 1
      ),
      all(is.finite(rows$pearson_residual) & is.finite(rows$quantile_residual)),
      all(is.finite(rows$conditional_variance) & rows$conditional_variance > 0),
      sum(result$boundary_prediction$grouping == "state") == 9L,
      sum(result$boundary_prediction$claim_gate_applicable) == 5L,
      nrow(extra) == 6L,
      sum(result$temporal_correlation$residual_type == "Pearson") == 3L,
      !any(result$participant_influence$selected_for_bounded_refit),
      sha256(selection$model_path) == selection$model_sha256,
      !result$bundle$fit_gate$structural_failure,
      nrow(seed_row) == 1L && seed_row$draws == 250L
    )
  )
  result$assessment <- data.table::rbindlist(
    list(
      result$assessment,
      data.frame(
        sample_id = job$seed_slot,
        target = "temporal_numerical_fit",
        status = selection$fit_status,
        detail = paste(
          "Selected sensitivity route",
          selection$route,
          "; not a primary replacement"
        )
      )
    ),
    fill = TRUE
  )
  result$bundle <- NULL
  result$source_path <- selection$model_path
  result$source_sha256 <- selection$model_sha256
  result$construction_validation <- checks
  result$seed_slot <- seed_row
  result$accepted <- FALSE
  for (name in c(
    "row_data",
    "calibration",
    "boundary_prediction",
    "residual_group_summary",
    "residual_patterns",
    "state_residual_covariance",
    "temporal_correlation",
    "temporal_gap_summary",
    "participant_influence",
    "assessment"
  ))
    lb_write_csv(result[[name]], file.path(relative_output, paste0(name, ".csv")))
  lb_write_csv(checks, file.path(relative_output, "construction_checks.csv"))
  lb_write_csv(seed_row, file.path(relative_output, "draw_usage.csv"))
  lb_save_rds(result, file.path(relative_output, "diagnostics.rds"))
  lb_manifest(
    list.files(file.path(stage2_root, relative_output), full.names = TRUE),
    file.path(relative_output, "manifest.csv")
  )
  print(checks)
  print(result$assessment)
  stopifnot(!anyNA(checks$pass), all(checks$pass))
