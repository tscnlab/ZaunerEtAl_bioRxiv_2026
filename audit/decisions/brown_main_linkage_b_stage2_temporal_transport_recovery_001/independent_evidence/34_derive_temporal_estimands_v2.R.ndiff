  # Report the first structurally eligible temporal route, or all-rung failure.
  
  source(file.path(
    Sys.getenv("BROWN_ADHERENCE_PROJECT_ROOT"),
    "audit/analyses/brown_adherence/main_linkage_b_amendment/stage2/code/runtime_contract.R"
  ))
  args <- commandArgs(trailingOnly = TRUE)
  stopifnot(length(args) == 1L, args %in% c("ANY", "80"))
  sample <- args[1L]
- registry_root <- file.path(stage2_root, "preflight/calendar_date_recovery_001")
+ registry_root <- file.path(
+   stage2_root,
+   "preflight/temporal_transport_recovery_001"
+ )
  lb_assert_manifest(file.path(registry_root, "temporal_fit_source_manifest.csv"))
  jobs <- read.csv(file.path(
    registry_root,
    "temporal_reporting_job_registry.csv"
  ))
  job <- jobs[
    jobs$job_id == paste0("DERIVE-SENSITIVITY-TEMPORAL-", sample),
    ,
    drop = FALSE
  ]
  stopifnot(
    nrow(job) == 1L,
    !dir.exists(job$output_root),
    sha256(job$driver_path) == job$driver_sha256
  )
  fits <- read.csv(file.path(registry_root, "temporal_fit_job_registry.csv"))
  fits <- fits[fits$sample == sample, , drop = FALSE]
  fits <- fits[order(fits$ladder_index), , drop = FALSE]
  gates <- list()
  selected_index <- NA_integer_
  for (i in seq_len(nrow(fits))) {
    lb_assert_manifest(file.path(fits$output_root[i], "manifest.csv"))
    gate <- read.csv(file.path(fits$output_root[i], "fit_gate.csv"))
    stopifnot(nrow(gate) == 1L, !is.na(gate$structural_failure))
    gates[[i]] <- gate
    if (!gate$structural_failure) {
      selected_index <- i
      stopifnot(!any(dir.exists(fits$output_root[fits$ladder_index > i])))
      break
    }
  }
  source(file.path(analysis_root, "stage2/model_contract.R"))
  source(file.path(code_root, "boundary_model_contract.R"))
- source(file.path(code_root, "30_temporal_fit_contract.R"))
+ source(file.path(code_root, "30_temporal_fit_contract_v2.R"))
?                                                      +++
  source(file.path(code_root, "31_temporal_reporting_contract.R"))
  index <- if (is.na(selected_index)) nrow(fits) else selected_index
  path <- file.path(fits$output_root[index], "model.rds")
  bundle <- readRDS(path)
  if (bundle$route == "ENDPOINT-R3" && !bundle$fit_gate$structural_failure)
    dyn.load(file.path(historical_root, "endpoint_inflated_ou_estimands.so"))
  report <- lb_temporal_report_bundle(bundle)
  relative_output <- file.path("temporal", sample, "reporting")
  selection <- data.frame(
    sample = sample,
    model_id = bundle$model_id,
    route = bundle$route,
    model_path = path,
    model_sha256 = sha256(path),
    estimates_eligible = !is.na(selected_index),
    fit_status = bundle$fit_gate$fit_status,
    accepted = FALSE
  )
  lb_write_csv(selection, file.path(relative_output, "selection.csv"))
  lb_write_csv(
    data.table::rbindlist(gates, fill = TRUE),
    file.path(relative_output, "candidate_gates.csv")
  )
  lb_write_csv(report$status, file.path(relative_output, "status.csv"))
  if (selection$estimates_eligible) {
    primary <- read.csv(file.path(stage2_root, "multiplicity/BA_M1.csv"))
    primary <- primary[
      primary$sample_id ==
        if (sample == "ANY") "primary_any_valid" else "support_80",
      ,
      drop = FALSE
    ]
    state_index <- match(report$contrasts$analysis_state, primary$analysis_state)
    stopifnot(nrow(primary) == 3L, !anyNA(state_index))
    comparison <- report$contrasts
    comparison$primary_estimate <- primary$estimate[state_index]
    comparison$primary_conf_low <- primary$conf_low[state_index]
    comparison$primary_conf_high <- primary$conf_high[state_index]
    comparison$shift_percentage_points <- 100 *
      (comparison$estimate - comparison$primary_estimate)
    comparison$direction_retained <- sign(comparison$estimate) ==
      sign(comparison$primary_estimate)
    comparison$interval_exclusion_retained <- (comparison$conf_low > 0 |
      comparison$conf_high < 0) ==
      (comparison$primary_conf_low > 0 | comparison$primary_conf_high < 0)
    report$primary_comparison <- comparison
    lb_write_csv(comparison, file.path(relative_output, "primary_comparison.csv"))
    lb_write_csv(report$quadrature, file.path(relative_output, "quadrature.csv"))
    lb_write_csv(
      cbind(report$cells$grid, estimate = report$cells$probability),
      file.path(relative_output, "cell_means.csv")
    )
    lb_write_csv(
      data.frame(
        analysis_state = report$contrasts$analysis_state,
        report$contrast_matrix,
        check.names = FALSE
      ),
      file.path(relative_output, "contrast_matrix.csv")
    )
    lb_write_csv(
      data.frame(
        uncertainty = report$uncertainty,
        no_primary_replacement = TRUE,
        no_new_multiplicity_family = TRUE
      ),
      file.path(relative_output, "uncertainty_scope.csv")
    )
  }
  report$accepted <- FALSE
  report$selection <- selection
  lb_save_rds(report, file.path(relative_output, "estimands.rds"))
  checks <- data.frame(
    check = c(
      "first_eligible_or_all3_failed",
      "no_unneeded_later_fit",
      "exact_selected_model_identity",
      "three_contrasts_if_eligible",
      "quadrature_if_eligible",
      "no_failed_model_inference",
      "no_pvalue_or_new_family"
    ),
    pass = c(
      if (is.na(selected_index))
        length(gates) == 3L &&
          all(vapply(gates, function(x) x$structural_failure, logical(1))) else
        all(vapply(
          head(gates, -1L),
          function(x) x$structural_failure,
          logical(1)
        )) &&
          !gates[[selected_index]]$structural_failure,
      !any(dir.exists(fits$output_root[fits$ladder_index > index])),
      sha256(path) == selection$model_sha256,
      if (selection$estimates_eligible) nrow(report$contrasts) == 3L else
        is.null(report$contrasts),
      if (selection$estimates_eligible) all(report$quadrature$pass) else
        is.null(report$quadrature),
      !bundle$fit_gate$structural_failure || is.null(report$contrasts),
      is.null(report$contrasts) ||
        !any(grepl("p_value|p_adjusted|statistic", names(report$contrasts)))
    )
  )
  lb_write_csv(checks, file.path(relative_output, "checks.csv"))
  lb_manifest(
    c(list.files(job$output_root, full.names = TRUE), path),
    file.path(relative_output, "manifest.csv")
  )
  if (bundle$route == "ENDPOINT-R3" && !bundle$fit_gate$structural_failure)
    dyn.unload(file.path(historical_root, "endpoint_inflated_ou_estimands.so"))
  print(selection[, c("sample", "route", "estimates_eligible", "fit_status")])
  print(checks)
  stopifnot(!anyNA(checks$pass), all(checks$pass))
