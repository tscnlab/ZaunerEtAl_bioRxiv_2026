    "figures": [
      {
        "alt": "A horizontal dot plot shows contributing participant-days for all 17 metrics. Near-eye values range from 655 to 816 days and chest values from 743 to 902 days, with lower support for several sleep, wake, and timing metrics.",
        "assetHeight": 749,
        "assetWidth": 1008,
        "caption": "Figure 1: Contributing participant-days for each primary near-eye and complementary chest model. Participant-level dynamics outcomes use all contributing days to form one fitted observation per participant.",
        "height": 803,
        "i": 1,
        "id": "fig-h01-prep-sample-support",
        "naturalHeight": 1497,
        "naturalWidth": 2016,
        "width": 1149
      },
      {
        "alt": "A horizontal dot plot shows model-frame retention for all 17 outcomes. Many outcomes retain all prepared rows, while sleep, wake, dose, and timing metrics retain smaller percentages. Near-eye and chest patterns are similar but not identical.",
        "assetHeight": 749,
        "assetWidth": 1008,
        "caption": "Figure 2: Percentage of prepared metric rows retained in the complete site-plus-photoperiod model frame. Losses reflect outcome-specific availability and complete-case predictors; they are not post-fit exclusions.",
        "height": 803,
        "i": 2,
        "id": "fig-h01-prep-model-frame-retention",
        "naturalHeight": 1497,
        "naturalWidth": 2016,
        "width": 1149
      }
    ],
