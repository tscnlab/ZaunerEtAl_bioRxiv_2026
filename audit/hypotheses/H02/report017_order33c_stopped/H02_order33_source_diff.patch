+collect_call_heads <- function(expression) {
+  heads <- character()
+  visit <- function(node) {
+    if (is.expression(node) || is.pairlist(node)) {
+      for (element in node) visit(element)
+      return(invisible(NULL))
+    }
+    if (!is.call(node)) return(invisible(NULL))
+    head <- call_head_name(node[[1L]])
+    if (!is.na(head)) heads <<- c(heads, head)
+    if (length(node) > 1L) {
+      for (index in seq.int(2L, length(node))) visit(node[[index]])
+    }
+    invisible(NULL)
+  }
+  visit(expression)
+  heads
+}
 
