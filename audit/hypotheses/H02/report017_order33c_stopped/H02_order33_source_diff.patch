+remove_fenced_code <- function(lines) {
+  in_fence <- FALSE
+  visible_lines <- character()
+  for (line in lines) {
+    if (grepl("^[[:space:]]*```", line, perl = TRUE)) {
+      in_fence <- !in_fence
+    } else if (!in_fence) {
+      visible_lines <- c(visible_lines, line)
+    }
+  }
+  stopifnot(!in_fence)
+  paste(visible_lines, collapse = "\n")
